# ===========================================
# Travel-AI Environment Variables
# ===========================================

# Application
ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=travelai
POSTGRES_PASSWORD=travelai_dev_password
POSTGRES_DB=travelai
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# JWT
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Anthropic (Claude API)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Amadeus API
AMADEUS_API_KEY=your-amadeus-api-key
AMADEUS_API_SECRET=your-amadeus-api-secret
AMADEUS_BASE_URL=https://test.api.amadeus.com

# RapidAPI (Skyscanner, Kiwi, Google Flights)
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_SKYSCANNER_HOST=fly-scraper.p.rapidapi.com
RAPIDAPI_KIWI_HOST=flights-scraper-real-time.p.rapidapi.com
RAPIDAPI_GOOGLE_FLIGHTS_HOST=google-flights-data.p.rapidapi.com

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@travel-ai.com
EMAIL_FROM_NAME=Travel-AI

# Tier Switch (dev/test only)
ALLOW_TIER_SWITCH=true
